# Copy to .env for docker compose. Everything is optional in dev.
# STACKSENSE_SECRET_KEY=          # token signing; required (non-default) in production
# STACKSENSE_MASTER_KEY=          # base64 32-byte key that wraps per-subject data keys
# STACKSENSE_STRIPE_SECRET_KEY=   # empty = fake checkout with signed synthetic webhooks
# STACKSENSE_STRIPE_WEBHOOK_SECRET=
# STACKSENSE_ANTHROPIC_API_KEY=   # empty = template wording (the LLM only words; rules decide)
# STACKSENSE_SMTP_URL=            # smtp://user:pass@host:587 ; empty = emails go to the log
